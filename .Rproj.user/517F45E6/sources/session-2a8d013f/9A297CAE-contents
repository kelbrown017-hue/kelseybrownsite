chisq.test(table(df$Region, df$Revenue))

#TrafficType
ggplot(df, aes(x = factor(TrafficType), fill = Revenue)) +
  geom_bar(position = "fill") +
  labs(title = "Revenue Rate by TrafficType", x = "TrafficType", y = "Proportion") +
  theme_minimal()

chisq.test(table(df$TrafficType, df$Revenue))

#SpecialDay
