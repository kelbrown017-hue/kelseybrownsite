               levels = c("FALSE", "TRUE"), direction = "<", quiet = TRUE)
    fold_aucs[fold] <- auc(roc_obj) #calculates area underneath roc object
  }
  
  cv_results$mean_auc[cv_results$k == k_val] <- mean(fold_aucs) #Average all 10 aucs into a single number for the k
}

