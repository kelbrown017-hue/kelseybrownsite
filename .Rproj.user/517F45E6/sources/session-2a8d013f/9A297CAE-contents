#Storing average AUC for each k
cv_results <- data.frame(k = k_values, mean_auc = NA)

for (k_val in k_values) {
  fold_aucs <- numeric(n_folds) #Empty numeric vector for the aucs
  
  for (fold in 1:n_folds) { #For every fold
    #Splitting into CV-train and CV-validation for this fold
    cv_train <- train_knn_balanced[folds != fold, ] #Every row that is not in the fold 
    cv_val <- train_knn_balanced[folds == fold, ] #Rows in the fold 
    
    #Separating predictors and target
    cv_train_x <- cv_train[, !names(cv_train) %in% "Revenue"]
    cv_val_x <- cv_val[, !names(cv_val) %in% "Revenue"]
    cv_train_y <- cv_train$Revenue
    cv_val_y <- cv_val$Revenue
    
    #Fitting the model and getting predictions
    pred <- knn(train = cv_train_x, test = cv_val_x, cl = cv_train_y, k = k_val, prob = TRUE)

